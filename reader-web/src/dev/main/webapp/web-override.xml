<?xml version="1.0" encoding="UTF-8"?>
<web-app id="reader"
  xmlns="http://java.sun.com/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
  version="3.0"> 

  <!-- Override init parameter to avoid nasty file locking issue on windows. -->
  <servlet>
    <servlet-name>default</servlet-name>
    <init-param>
      <param-name>useFileMappedBuffer</param-name>
      <param-value>false</param-value>
    </init-param>
    <!-- Development only: without this the browser caches the JavaScript, CSS and locale
         files and keeps serving a stale copy after you edit them, which looks like your
         change had no effect. Production builds are unaffected: this descriptor is only
         applied by the jetty:run configuration in reader-web/pom.xml. -->
    <init-param>
      <param-name>cacheControl</param-name>
      <param-value>no-store, no-cache, must-revalidate</param-value>
    </init-param>
  </servlet>
</web-app>
