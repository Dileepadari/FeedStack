@startuml

class AppContext{
    - {static} instance : AppContext
    - eventBus : EventBus
    - asyncEventBus : EventBus
    - mailEventBus : EventBus
    - importEventBus : EventBus
    - feedService : FeedService
    - indexingService : IndexingService
    - asyncExecutorList : List<ExecutorService>
    - AppContext()
    - resetEventBus() : void
    + {static} getInstance() : AppContext
    + waitForAsync() : void
    - newAsyncEventBus() : EventBus
    + getEventBus() : EventBus
    + getAsyncEventBus() : EventBus
    + getMailEventBus() : EventBus
    + getImportEventBus() : EventBus
    + getFeedService() : FeedService
    + getIndexingService() : IndexingService
}

class Feed{
    - id : String
    - rssUrl : String
    - url : String
    - baseUri : String
    - title : String
    - language : String
    - description : String
    - createDate : Date
    - lastFetchDate : Date
    - deleteDate : Date
    + Feed()
    + Feed(id : String)
    + getId() : String
    + setId(id : String) : void
    + getRssUrl() : String
    + setRssUrl(rssUrl : String) : void
    + getUrl() : String
    + setUrl(url : String) : void
    + getBaseUri() : String
    + setBaseUri(baseUri : String) : void
    + getTitle() : String
    + setTitle(title : String) : void
    + getLanguage() : String
    + setLanguage(language : String) : void
    + getDescription() : String
    + setDescription(description : String) : void
    + getCreateDate() : Date
    + setCreateDate(createDate : Date) : void
    + getLastFetchDate() : Date
    + setLastFetchDate(lastFetchDate : Date) : void
    + getDeleteDate() : Date
    + setDeleteDate(deleteDate : Date) : void
