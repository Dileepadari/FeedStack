}

class FeedService{
    - {static} log : Logger
    # startUp() : void
    # shutDown() : void
    # runOneIteration() : void
    # scheduler() : Scheduler
    + synchronizeAllFeeds() : void
    + synchronize(url : String) : Feed
    - completeArticleList(articleList : List<Article>) : void
    - getArticleToRemove(articleList : List<Article>) : List<Article>
    - getNewerArticleList(articleList : List<Article>, oldestArticle : Article) : List<Article>
    - getOldestArticle(articleList : List<Article>) : Article
    - isFaviconUpdated(feed : Feed) : boolean
    - parseFeedOrPage(url : String, parsePage : boolean) : RssReader
    - logParsingError(url : String, e : Exception) : void
    + createInitialUserArticle(userId : String, feedSubscription : FeedSubscription) : void
}

class IndexingService{
    - {static} log : Logger
    - directory : Directory
    - directoryReader : DirectoryReader
    - luceneStorageConfig : String
    + IndexingService(luceneStorageConfig : String)
    # startUp() : void
    # shutDown() : void
    # runOneIteration() : void
    # scheduler() : Scheduler
    + searchArticles() : PaginatedList<UserArticleDto>
    + rebuildIndex() : void
    + getDirectory() : Directory
    + getDirectoryReader() : DirectoryReader
}

class FeedSynchronizationDao{
    + create(feedSynchronization : FeedSynchronization) : String
