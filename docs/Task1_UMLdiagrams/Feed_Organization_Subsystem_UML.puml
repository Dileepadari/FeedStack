}

class FeedSynchronizationDao{
    + create(feedSynchronization : FeedSynchronization) : String
    + deleteOldFeedSynchronization(feedId : String, minutes : int) : void
    + findByFeedId(feedId : String) : List<FeedSynchronization>
}

class BaseDao{
    + findByCriteria(list : PaginatedList<T>, criteria : C, sortCriteria : SortCriteria, filterCriteria : FilterCriteria) : void
    + findByCriteria(criteria : C, sortCriteria : SortCriteria, filterCriteria : FilterCriteria) : List<T>
    + findByCriteria(criteria : C) : List<T>
    + findFirstByCriteria(criteria : C) : T
    # {abstract} getQueryParam(criteria : C, filterCriteria : FilterCriteria) : QueryParam
}

class QueryParam{
    - queryString : String
    - criteriaList : List<String>
    - sortCriteria : SortCriteria
    - parameterMap : Map<String,Object>
    - filterCriteria : FilterCriteria
    - groupByList : List<String>
    - resultMapper : ResultMapper
    + QueryParam()
    + QueryParam()
    + getQueryString() : String
    + setQueryString(queryString : String) : void
    + getSortCriteria() : SortCriteria
    + getCriteriaList() : List<String>
    + getParameterMap() : Map<String,Object>
    + getFilterCriteria() : FilterCriteria
    + getGroupByList() : List<String>
    + getResultMapper() : ResultMapper
    + setSortCriteria(sortCriteria : SortCriteria) : void
}

class FilterCriteria{
    - filterColumnList : List<FilterColumn>
    + FilterCriteria(filterColumnList : List<FilterColumn>)
    + getFilterColumnList() : List<FilterColumn>
}

AppContext -- FeedService
AppContext -- IndexingService

FeedService --> FeedDao
FeedService --> RssReader
FeedService --> FeedSynchronizationDao
FeedService --> IndexingService
FeedService --> FaviconUpdateRequestedEvent

IndexingService --> ArticleDao
Feed "1" --> "*" Article
UserArticle "*" --> "1" Article
FeedSubscription "*" --> "1" Feed
FeedSubscription "*" --> "1" Category

RssReader --> ArticleSanitizer
ArticleSanitizer --> TextSanitizer

BaseDao <|-- FeedDao
BaseDao <|-- ArticleDao
BaseDao <|-- UserArticleDao

FeedSynchronizationDao --> FeedSynchronization

QueryParam --> FilterCriteria
FilterCriteria --> FilterColumn

IndexingService --> Directory
IndexingService -- QueryParam

UserArticleDao --> UserArticle

ArticleDao --> Article

FeedService ..> FeedDto
FeedService ..> FeedMapper
FeedService ..> Constants

ArticleDao ..> ArticleDto
ArticleDao ..> ArticleMapper
ArticleDao ..> Constants

UserArticleDao ..> UserArticleMapper
UserArticleDao ..> Constants

RssReader ..> DirectoryUtil

@enduml